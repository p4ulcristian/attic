;; groundwork-file-storage: groundwork's file storage. Files named by their content in an S3 bucket
;; (R2, S3, any S3 API), each recorded in a table; links for the browser,
;; public or signed; uploads through the server, checked by their bytes.
;; One tree: source-code/groundwork_file_storage/.
{:paths ["source-code"]

 :deps
 {;; the bucket: cognitect's aws-api, S3 only
  com.cognitect.aws/api       {:mvn/version "0.8.847"}
  com.cognitect.aws/endpoints {:mvn/version "871.2.57.0"}
  com.cognitect.aws/s3        {:mvn/version "871.2.55.11"}
  ;; the files table, a map for groundwork-postgres, and its queries
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks,
  ;; a reference what it does on delete, update and when checked; migrate! takes
  ;; {:tables :extensions :functions :views}; run-after-commit!, for delete-file-after-commit!;
  ;; run-in-transaction! takes the caller's :log, where an after-commit failure is written
  io.github.p4ulcristian/groundwork-postgres  {:git/tag "v0.4.7" :git/sha "d6f226c"}
  ;; the upload's answer, JSON by the shaper the app makes and hands in
  io.github.p4ulcristian/groundwork-shaped-json    {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
  ;; the app's log, handed in
  io.github.p4ulcristian/groundwork-logs {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; the app's meter, handed in: files stored, files refused
  io.github.p4ulcristian/groundwork-metrics   {:git/tag "v0.1.5" :git/sha "1cffe8e"}
  ;; the bucket's key, secrets that print as their names
  io.github.p4ulcristian/groundwork-settings    {:git/tag "v0.1.2" :git/sha "25dfbf7"}
  ;; an upload's parts: ring's multipart parser
  ring/ring-core                {:mvn/version "1.15.6"}
  ;; the settings and options, checked before anything runs
  metosin/malli                 {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test  (the bucket and Postgres ones need FILE_STORAGE_TEST_*, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
