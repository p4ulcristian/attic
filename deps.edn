;; attic: manor's file storage. Files named by their content in an S3 bucket
;; (R2, S3, any S3 API), each recorded in a table; links for the browser,
;; public or signed; uploads through the server, checked by their bytes.
;; One tree: source-code/attic/.
{:paths ["source-code"]

 :deps
 {;; the bucket: cognitect's aws-api, S3 only
  com.cognitect.aws/api       {:mvn/version "0.8.847"}
  com.cognitect.aws/endpoints {:mvn/version "871.2.57.0"}
  com.cognitect.aws/s3        {:mvn/version "871.2.55.11"}
  ;; the files table, a map for cellar, and its queries
  io.github.p4ulcristian/cellar  {:git/tag "v0.4.3" :git/sha "e164607"}
  ;; the upload's answer, JSON by the wire the app makes and hands in
  io.github.p4ulcristian/wire    {:git/tag "v0.2.0" :git/sha "d66b7cb"}
  ;; the app's log, handed in
  io.github.p4ulcristian/logbook {:git/tag "v0.1.1" :git/sha "51a2c93"}
  ;; the app's meter, handed in: files stored, files refused
  io.github.p4ulcristian/meter   {:git/tag "v0.1.3" :git/sha "b71484d"}
  ;; the bucket's key, secrets that print as their names
  io.github.p4ulcristian/safe    {:git/tag "v0.1.0" :git/sha "b4783eb"}
  ;; an upload's parts: ring's multipart parser
  ring/ring-core                {:mvn/version "1.15.6"}
  ;; the settings and options, checked before anything runs
  metosin/malli                 {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test  (the bucket and Postgres ones need ATTIC_TEST_*, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
